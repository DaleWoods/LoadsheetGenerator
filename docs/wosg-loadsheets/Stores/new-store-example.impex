
$lang=en
$storeUid=aurumBaseStore
$countryCode=GB
$contentCatalog=aurumContentCatalog

$baseStore=basestore(uid)[default=$storeUid]
$posType=type(code)[default=STORE]
$country=country(isocode)[default=$countryCode]
$StandardDateFormat=hh:mm
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Staged])[default=$contentCatalog:Staged]

# Define Store Address

INSERT_UPDATE Address;&addrID;streetnumber;streetname;district;town;postalcode;$country;phone1;fax;email;appartment;company;lastname;firstname;owner(PointOfService.name)[unique=true];
;posAddress126;3;Clumber Street;;Nottingham;NG1 3ED;;0115 947 4907;;126@email.com;;;lastName;firstName;126;

# Define Opening Shedule

INSERT_UPDATE OpeningSchedule;code[unique=true];
;standard-hours-126;

INSERT_UPDATE WeekdayOpeningDay;dayOfWeek(code,itemtype(code))[unique=true];openingTime[dateformat=hh:mm];closingTime[dateFormat=$StandardDateFormat];openingSchedule(code)[unique=true];
;MONDAY:WeekDay     ;09:00;17:30;standard-hours-126;
;TUESDAY:WeekDay    ;09:00;17:30;standard-hours-126;
;WEDNESDAY:WeekDay  ;09:00;17:30;standard-hours-126;
;THURSDAY:WeekDay   ;09:00;17:30;standard-hours-126;
;FRIDAY:WeekDay     ;09:00;17:30;standard-hours-126;
;SATURDAY:WeekDay   ;09:00;17:30;standard-hours-126;
;SUNDAY:WeekDay     ;10:30;16:30;standard-hours-126;

# Store Details

INSERT_UPDATE AurumPointOfService;name[unique=true];displayName;$posType;address(&addrID);latitude;longitude;geocodeTimestamp[dateformat=dd-MM-yyyy];isClickAndCollectEnabled;isReserveAndCollectEnabled;storeManager;openingSchedule(code);
;126;Nottingham (CS);;posAddress126;52.953832;-1.147592;01-01-1970;1;1;Manager Name;standard-hours-126;

INSERT_UPDATE StoreDescription;code[unique=true];facilities[lang=$lang];managerQuote[lang=$lang];features(key(isocode[lang=$lang]),value)[map-delimiter=|];
;126_storeDescription;Description for pos 126;Manager Quote for pos 126;Diamond Specialists,On site Watchmaker,Breitling accredited,Omega accredited,TAG Heuer accredited;

UPDATE AurumPointOfService;name[unique=true];storeDescription(code);baseStore(uid)[mode=append];
;126;126_storeDescription;$storeUid;

UPDATE AurumPointOfService;name[unique=true];storeIpAddress;$baseStore;
;126;"1.2.3.X";

INSERT_UPDATE Media;mediaFormat(qualifier);code[unique=true];URL;mime[default='image/jpeg'];$contentCV;
;;storeImage126;IMAGE_URL_HERE;

INSERT_UPDATE AurumPointOfService;name[unique=true];aurumStoreImage(code, $contentCV);
;126;storeImage126;

# Assign Brands to Store

INSERT_UPDATE StoreBrand;code[unique=true];name;image(code, $contentCV);linkText[unique=true];linkURL;
;storeBrandItem;storeBrandItem;ItemCode;storeBrandItem;#;

UPDATE AurumPointOfService;name[unique=true];brands(code);
;126;storeBrandItem;
