# ImpEx for Importing Products
"#% impex.enableCodeExecution(true);"

$productCatalog=masterProductCatalog
$lang=en

$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]


INSERT_UPDATE Product;code[unique=true];specialBrandField1[lang=$lang];specialBrandField2[lang=$lang];specialBrandField3[lang=$lang];specialBrandDescription[lang=$lang];$catalogVersion
"#% impex.includeExternalDataMedia( ""ProductSpecialBrandLoadsheet.csv"", ""UTF-8"", ',', 1, 0);"
