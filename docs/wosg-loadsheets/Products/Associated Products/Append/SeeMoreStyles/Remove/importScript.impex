# ImpEx for Removing See More Styles Products
"#% impex.enableCodeExecution(true);"

$productCatalog=masterProductCatalog
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]

INSERT_UPDATE Product;code[unique=true];seeMoreStylesRef(code, $catalogVersion)[mode=remove,collection-delimiter='|'];$catalogVersion
"#% impex.includeExternalDataMedia( ""SeeMoreStylesLoadsheet.csv"", ""UTF-8"", ',', 1, -1);"