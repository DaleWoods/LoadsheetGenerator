# ImpEx for Importing Products
"#% impex.enableCodeExecution(true);"

$productCatalog=masterProductCatalog
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]

INSERT_UPDATE Product;code[unique=true];seeMoreStyles(code, $catalogVersion)[mode=remove];youMayAlsoLike(code, $catalogVersion)[mode=remove];$catalogVersion
"#% impex.includeExternalDataMedia( ""AssociatedProductsRemoveLoadsheet.csv"", ""UTF-8"", ',', 1, 0);"
