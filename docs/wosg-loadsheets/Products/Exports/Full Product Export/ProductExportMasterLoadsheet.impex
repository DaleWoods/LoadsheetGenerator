"#% impex.setTargetFile( ""products.csv"" );"

$productCatalog=masterProductCatalog
$lang=en
$lang2=en_US
# When you don't want to use land2 set it to a languague in the system we don't currently use, in this case hu is Hungarian

$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=supercategories(code, $catalogVersion)[mode=append]
$approved=approvalstatus(code)[default='unapproved']
$unit=unit(code)[default=EA]

INSERT_UPDATE Product;code[unique=true];$supercategories;manufacturerName;name[lang=$lang];name[lang=$lang2];description[lang=$lang];description[lang=$lang2];manufacturerAID;EAN;syncToSite(uid);purchaseOnSite(uid);priceVisibleOnSite(uid);virtualStockOnSite(uid);giftWrapOnSite(uid);homeDeliveryAvailableOnSite(uid);clickAndCollectAvailableOnSite(uid);enablePaypalCreditOnSite(uid);enablePaypalExpressOnSite(uid);usePngImageFormat;pageTitle[lang=$lang];varianttype(code);measurements[lang=$lang];metaDescription[lang=$lang];metaKeywords[lang=$lang];specialBrandField1[lang=$lang];specialBrandField2[lang=$lang];specialBrandField3[lang=$lang];specialBrandDescription[lang=$lang];productType(code)

"#% impex.exportItemsFlexibleSearch(""select {pk} FROM {Product} where {CatalogVersion} = '8796125889113' and {code} IN ('M37711290')"");"

