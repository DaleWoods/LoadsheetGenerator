# ImpEx for Importing Products
"#% impex.enableCodeExecution(true);"

$productCatalog=masterProductCatalog
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]

INSERT_UPDATE Product;code[unique=true];excludedFromFinanceProviders(code)[mode=remove];excludedFromFinancePlans(code)[mode=remove];$catalogVersion
"#% impex.includeExternalDataMedia( ""ProductFinanceExclusionsRemoveLoadsheet.csv"", ""UTF-8"", ',', 1, 0);"
