# ImpEx for Importing Facets
"#% impex.enableCodeExecution(true);"

$lang=en

INSERT_UPDATE ProductFacetType;code[unique=true];name[lang=$lang]
"#% impex.includeExternalDataMedia( ""ProductFacetTypes.csv"", ""UTF-8"", ',', 1, 0);"

INSERT_UPDATE ProductFacetValue;code[unique=true];value[lang=$lang];
"#% impex.includeExternalDataMedia( ""ProductFacetValue.csv"", ""UTF-8"", ',', 1, 0);"

