$lang=en
"#% impex.setTargetFile( ""Orders.csv"" );"
INSERT_UPDATE Order;code[alias=Order No.];date[alias=Order Date];currency(isocode)[alias=Currency];totalPrice[alias=Total Price];totalTax[alias=Tax];user(uid)[alias=Customer];status(code)[alias=Order Status];paymentInfo(adyenPaymentMethod)[alias=Payment Mode];paymentInfo(itemtype(code))[alias=Payment Info Type];deliveryMode(code)[alias=Delivery Mode];deliveryType(code)[alias=Delivery Type];discounts[alias=Discounts];appliedCouponCodes[alias=Promo Code Applied];wesStoreId[alias=WES If Store:Yes];salesApplication(code)[alias=Sales Application];sapDeliveryNumber[alias=SAP Delivery Number];site(uid)[alias=Site];store(uid)[alias=Store];entries(product(name[lang=$lang]),product(code),quantity,basePrice,totalPrice);entries(product(manufacturerName))[alias=Brand];;paymentStatus(code)[alias=Payment Status];paymentAddress(company,appartment,building,streetnumber,StreetName,district,town,county,region(name[lang=$lang]),postalCode,country(name[lang=$lang]));deliveryAddress(company,appartment,building,streetnumber,StreetName,district,town,county,region(name[lang=$lang]),postalCode,country(name[lang=$lang]));consignments(status(code))[alias=Consignment Status];consignments(shippingDate)[alias=ShippingDate];consignments(carrier)[alias=Carrier];consignments(trackingID)[alias=Tracking ID];paymentInfo(AdyenPaymentInfo.adyenPaymentMethod|blankValue[virtual=true,default=""])[alias=Adyen Payment Method];paymentInfo(AdyenPaymentInfo.adyenPaymentMethodVariant|blankValue[virtual=true,default=""])[alias=Adyen Payment Method Variant];paymentInfo(V12PaymentInfo.applicationId|blankValue[virtual=true,default=""])[alias=V12 Payment - Application ID];paymentInfo(V12PaymentInfo.apr|blankValue[virtual=true,default=""])[alias=V12 Payment - APR];paymentInfo(V12PaymentInfo.creditPolicyTag|blankValue[virtual=true,default=""])[alias=V12 Payment - Credit Policy Tag];paymentInfo(V12PaymentInfo.deposit|blankValue[virtual=true,default=""])[alias=V12 Payment - Deposit];paymentInfo(V12PaymentInfo.months|blankValue[virtual=true,default=""])[alias=V12 Payment - Months];paymentInfo(V12PaymentInfo.plan(code)|blankValue[virtual=true,default=""])[alias=V12 Payment - Plan (Code)];paymentInfo(V12PaymentInfo.plan(name[lang=$lang])|blankValue[virtual=true,default=""])[alias=V12 Payment - Plan (Name)];paymentInfo(V12PaymentInfo.tag|blankValue[virtual=true,default=""])[alias=V12 Payment - tag];paymentInfo(V12PaymentInfo.status|blankValue[virtual=true,default=""])[alias=V12 Payment - status];paymentInfo(PayPalInstalmentPaymentInfo.authorisationId|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Authorisation ID];paymentInfo(PayPalInstalmentPaymentInfo.captureId|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Capture ID];paymentInfo(PayPalInstalmentPaymentInfo.financingFeeAmount|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Financing Fee Amount];paymentInfo(PayPalInstalmentPaymentInfo.financingMonthlyPayment|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Financing Monthly Payment];paymentInfo(PayPalInstalmentPaymentInfo.financingterm|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Financing Term];paymentInfo(PayPalInstalmentPaymentInfo.financingTotalCost|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Financing Total Cost];paymentInfo(PayPalInstalmentPaymentInfo.paymentType|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Payment Type];paymentInfo(PayPalInstalmentPaymentInfo.paymentId|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Payment ID];paymentInfo(PayPalInstalmentPaymentInfo.payer|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Payer];paymentInfo(PayPalInstalmentPaymentInfo.isFinancing|blankValue[virtual=true,default=""])[alias=Pay Pal Instalments - Is Financing];paymentInfo(PayPalPaymentInfo.code|blankValue[virtual=true,default=""])[alias= PayPal Payment - Code];paymentInfo(PayPalPaymentInfo.isFinancing|blankValue[virtual=true,default=""])[alias= PayPal Payment - Is Financing];paymentInfo(PayPalPaymentInfo.payer|blankValue[virtual=true,default=""])[alias= PayPal Payment - Payer];paymentInfo(PayPalPaymentInfo.payerId|blankValue[virtual=true,default=""])[alias= PayPal Payment - Payer ID];returnRequests(code)[alias=Return Request Number];returnRequests(RMA)[alias=RMA];returnRequests(status(name[lang=$lang]))[alias=Return Status];returnRequests(sapDeliveryNumber)[alias=Return Delivery Number];returnRequests(returnTotal)[alias=Return Total Value][numberformat==#.##];paymentTransactions(requestId)[alias=LoanID];wesStoreId(code)[alias=WES Store];
"#% impex.exportItemsFlexibleSearch(""select {o.pk} from {Order as o} where {o.creationtime} > '2020-01-01 00:00:00.0' AND  {o.creationtime} < '2021-01-01 00:00:00.0'"");"